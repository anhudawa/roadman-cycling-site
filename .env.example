# Beehiiv Newsletter Integration
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# Stripe (used by Strength Training checkout and Race Report checkout)
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_STRENGTH_PRICE_ID=price_...

# Race Predictor / Race Report
# Required for live Race Report checkout: STRIPE_SECRET_KEY plus either
# STRIPE_RACE_REPORT_PRICE_ID or the fallback price/currency below.
# If STRIPE_RACE_REPORT_PRICE_ID is unset, checkout creates inline price_data
# from RACE_REPORT_PRICE_CENTS and RACE_REPORT_CURRENCY.
STRIPE_RACE_REPORT_PRICE_ID=
RACE_REPORT_ACTIVE=true
RACE_REPORT_PRICE_CENTS=2900
RACE_REPORT_CURRENCY=usd
PREDICT_FREE_DAILY=3
PAID_REPORT_ADMIN_EMAIL=

# Stripe Webhook
# Required for paid Race Report delivery AND for The Roadman Method: Stripe
# must send checkout.session.completed events to /api/webhooks/stripe or
# /api/stripe-webhook. The dispatcher routes method_course sessions to the
# Method handler (grants access, mints the magic link, sends the welcome email).
STRIPE_WEBHOOK_SECRET=whsec_...

# ── The Roadman Method (12-week course members area, /method) ──
# REQUIRED to run the members area. Signs member session cookies and
# magic-link tokens; must be ≥ 32 characters. Also reused as the fallback
# secret by the Ask, Fantasy and rider-profile session helpers, so a
# single-secret deploy works. Auth throws on startup if this is missing.
METHOD_SESSION_SECRET=

# Checkout pricing. Prefer STRIPE_METHOD_PRICE_ID (a pre-created Stripe Price
# object) so pricing is editable in the dashboard without a deploy. If unset,
# checkout builds inline price_data from STRIPE_METHOD_PRICE_CENTS
# (defaults to 29700 = $297). STRIPE_SECRET_KEY above is also required.
STRIPE_METHOD_PRICE_ID=
STRIPE_METHOD_PRICE_CENTS=29700
# Copy shown under the checkout button. Keep it in sync with the real price.
NEXT_PUBLIC_METHOD_PRICE_LABEL=$297 · One payment · Lifetime access
# Optional: Stripe billing-portal link surfaced on /method/account. Omit to
# hide the "manage billing" row.
STRIPE_METHOD_BILLING_PORTAL_URL=

# Drip pacing: "weekly" releases one module every 7 days from the purchase
# date; "all-at-once" unlocks all twelve immediately. Currently defaults to
# all-at-once (review mode). Set to weekly for the real cohort experience.
METHOD_DRIP_MODE=all-at-once

# Skool community URL for the per-module "Discuss in Not Done Yet" CTA. When
# unset, the CTA shows a "threads coming soon" state instead of a dead link.
# e.g. https://www.skool.com/roadmancycling
METHOD_NDY_DISCUSSION_URL=

# Support address shown on /method/account and in transactional emails.
# Defaults to sarah@roadmancycling.com.
METHOD_SUPPORT_EMAIL=

# Optional unlisted YouTube ID for the /method/welcome hero video. When unset,
# the welcome page shows a "video coming soon" placeholder.
METHOD_WELCOME_VIDEO_YT_ID=

# Resend (transactional emails, Race Report delivery, admin notifications)
RESEND_API_KEY=re_...

# Vercel Blob
# Optional for generic PDF report storage. Race Reports currently deliver a
# secure web view, so checkout can still work without this token.
BLOB_READ_WRITE_TOKEN=

# Site URL (set in Vercel dashboard)
NEXT_PUBLIC_SITE_URL=https://roadmancycling.com

# Database
# Vercel Postgres. POSTGRES_URL is used by the app and local fixtures fall back
# only when it is absent; DATABASE_URL is included for tools that expect it.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
DATABASE_URL=

# YouTube Sync (for scripts/sync-youtube.ts) uses yt-dlp, no API key needed
YOUTUBE_CHANNEL_HANDLE=theroadmanpodcast

# Claude API (optional for AI quote extraction during YouTube sync)
ANTHROPIC_API_KEY=

# Admin Dashboard
ADMIN_PASSWORD=change-me-to-something-secure

# Analytics (optional)
NEXT_PUBLIC_GA_ID=

# Sponsor reports - Google Analytics 4
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Ted - Community Agent
# Skool login (Ted's account, not Anthony's). Stored as GitHub Actions secrets in prod.
SKOOL_EMAIL=
SKOOL_PASSWORD=
SKOOL_COMMUNITY_SLUG=roadman
SKOOL_INTRO_CATEGORY=Intro Yourself
# Where Ted sends warn/error alerts (Resend-powered; optional for local dev)
TED_ADMIN_ALERT_EMAIL=
TED_ALERT_FROM=ted@roadmancycling.com

# Optional: enables manual workflow triggers from /admin/ted/settings.
# Token needs the `actions:write` scope on GITHUB_REPO.
GITHUB_TOKEN=
GITHUB_REPO=anhudawa/roadman-cycling-site
GITHUB_DEFAULT_BRANCH=main

# Ask Roadman + MCP Server

# Voyage AI - primary embeddings provider (1024-dim voyage-3-large).
# Also used by PR #76 MCP server for episode/methodology embeddings.
VOYAGE_API_KEY=

# Embedding provider override (voyage | openai). Defaults to voyage.
EMBEDDING_PROVIDER=voyage

# OpenAI fallback for embeddings (only required if EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=

# Upstash Redis - sliding-window rate limiter for /api/ask + /api/mcp.
# In dev, leave empty and the limiter auto-bypasses.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Ask Roadman rate limits
#   _RPM    = requests / 10-minute window per session or IP
#   _DAILY  = requests / 24h per session or IP (anonymous only)
#   _RPH    = requests / hour per rider profile
ASK_ROADMAN_ANON_RPM=5
ASK_ROADMAN_ANON_DAILY=10
ASK_ROADMAN_PROFILE_RPH=30

# Brand citation tests (DEV-DATA-03)
# Weekly cron tests prompts against ChatGPT, Claude, Perplexity, Gemini to
# track Roadman mentions. ANTHROPIC_API_KEY and OPENAI_API_KEY above are
# reused. PERPLEXITY_API_KEY and GOOGLE_AI_API_KEY are optional — providers
# whose key is unset are skipped silently and surfaced in the admin UI as
# "Not configured".
PERPLEXITY_API_KEY=
GOOGLE_AI_API_KEY=

# ── Roadman Fantasy Tour ──────────────────────────────────────
# Session signing for the fantasy game (magic links + email deep
# links). Falls back to ASK_SESSION_SECRET / METHOD_SESSION_SECRET
# so a single-secret deploy works. Must be ≥ 32 chars.
FANTASY_SESSION_SECRET=

# Meta Conversions API (server-side Lead event on player verification,
# deduplicated against the client pixel by event_id). Leave empty to
# disable — the game works fine without it.
META_CAPI_ACCESS_TOKEN=
META_PIXEL_ID=

# Private beta gate for demo/preview deployments of /fantasy. When set,
# every fantasy page shows an access-code screen until the visitor
# presents this code (form or share link /api/fantasy/beta?code=...).
# NEVER set in production — the gate must not exist there.
FANTASY_BETA_CODE=
