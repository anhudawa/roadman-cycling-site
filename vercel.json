{
  "ignoreCommand": "if [ \"$VERCEL_ENV\" = \"production\" ]; then exit 1; fi; case \"$VERCEL_GIT_COMMIT_REF\" in main|feat/*|claude/*|codex/*) exit 1 ;; esac; exit 0",
  "redirects": [
    {
      "source": "/downloads/roadman-new-core.pdf",
      "destination": "/downloads/core-training-guide.pdf",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/downloads/core-training-guide.pdf",
      "destination": "https://drive.google.com/uc?export=download&id=1M7geF6Z9vW2S6OH52yCmHPjBHrnuQ_wp"
    }
  ],
  "headers": [
    {
      "source": "/downloads/core-training-guide.pdf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"core-training-guide.pdf\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=86400, stale-while-revalidate=604800"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/admin/sync/beehiiv",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/admin/sync/stripe",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/admin/agent/weekly-analysis",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/cron/daily-digest",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/cron/sync-all",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/score-all",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/ted-weekly-digest",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/ted-heartbeat",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/complete-past-bookings",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/beehiiv-snapshot",
      "schedule": "45 6 * * *"
    },
    {
      "path": "/api/cron/stripe-snapshot",
      "schedule": "50 6 * * *"
    },
    {
      "path": "/api/cron/diagnostic-digest",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/brand-citations",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/ndy-followups",
      "schedule": "*/10 * * * *"
    }
  ],
  "buildCommand": "npm run build"
}
